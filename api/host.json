{
  "version": "2.0",
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Results": "Information",
      "Function": "Information",
      "Host.Aggregator": "Information",
      "Worker": "Information",
      "com.opal.deltav": "Information"
    },
    "console": {
      "isEnabled": true
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "",
      "cors": {
        "allowedOrigins": ["*"],
        "supportCredentials": false
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
